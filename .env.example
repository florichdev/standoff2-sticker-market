# ==========================================
# Standoff 2 Sticker Market - Environment Configuration Template
# Copy this file to .env and fill in real values. NEVER commit .env to VCS!
# ==========================================

# Telegram Bot Credentials (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ1234567
OLD_BOT_TOKEN=

# Admin Access (comma-separated Telegram user IDs)
ADMIN_IDS=123456789,987654321

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/standoff_market
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Optional Redis Cache / FSM
REDIS_URL=

# Optional Network Proxy for Telegram Bot API
TELEGRAM_PROXY=

# Web Admin Hub & Management API
WEB_ADMIN_HOST=0.0.0.0
WEB_ADMIN_PORT=8000
WEB_ADMIN_SECRET=change_me_to_a_secure_random_string_32_chars_min

# Market & Monetization Rules (Telegram Stars)
STARS_TURBO_PRICE=50
STARS_STANDARD_PRICE=20
MAX_ACTIVE_ADS=10

# Channel Auto-Posting Service
AUTOPOST_ENABLED=false
AUTOPOST_CHANNEL_ID=-1001234567890
AUTOPOST_COOLDOWN_SECONDS=300

